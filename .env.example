# Copier vers .env.local et renseigner. .env.local n'est jamais commité.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Utilisée UNIQUEMENT par tests/isolation.test.ts.
# Ne jamais importer depuis app/ ou lib/ — le test échoue si la chaîne
# SERVICE_ROLE y apparaît.
SUPABASE_SERVICE_ROLE_KEY=

# Strava — API client à créer sur https://www.strava.com/settings/api
# Le CLIENT_ID est semi-public (apparaît dans l'URL d'autorisation OAuth).
# Le CLIENT_SECRET n'est utilisé que côté serveur pour l'échange du code.
# Si le secret transite un jour par un chat, un log ou un partage : rotater.
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=

# Clé symétrique pour chiffrer les tokens Strava au repos.
# Générer avec : openssl rand -base64 32
# Perdre cette clé rend tous les tokens illisibles → reconnexion Strava
# à la main pour chaque tenant. À sauvegarder hors dépôt.
STRAVA_TOKEN_KEY=

# API Anthropic — coach IA. Générer sur console.anthropic.com.
# Ne jamais exposer côté client. Le fichier lib/ai/tools.ts vérifie
# qu'aucun tenant_id n'est passé en paramètre au modèle.
ANTHROPIC_API_KEY=
